/* 聊天页：固定布局，顶部商品栏与底部输入栏不随消息滚动 */

/* 整页根容器：占满屏幕，flex 纵向布局，禁止页面自身滚动 */
.chat-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

/* 顶部商品栏：固定高度，不收缩 */
.chat-header {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--color-border);
  z-index: 10;
}

/* 消息列表：占据剩余空间，仅此区域滚动 */
.chat-body {
  flex: 1;
  min-height: 0;          /* 关键：让 flex 子项可以收缩，scroll-view 才能正确滚动 */
  padding: var(--spacing-sm) var(--spacing-md);
  box-sizing: border-box;
}

/* 底部输入栏：固定高度，不收缩 */
.chat-footer {
  flex-shrink: 0;
  border-top: 1rpx solid var(--color-border);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 10;
}
