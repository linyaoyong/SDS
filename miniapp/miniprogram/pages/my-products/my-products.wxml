<!-- 我的商品管理 -->
<wxs module="helper">
function resolveUrl(path) {
  if (!path) return ''
  if (path.indexOf('http') === 0 || path.indexOf('blob:') === 0) return path
  if (path.indexOf('/api/') === 0) return path
  if (path.indexOf('/') === 0) return 'http://localhost:8080/api' + path
  return path
}
function formatPrice(price) {
  if (price === undefined || price === null) return '0.00'
  return (price * 1).toFixed(2)
}
function getStatusText(status) {
  if (status === 0) return '草稿'
  if (status === 1) return '在售'
  if (status === 2) return '已售出'
  return '已下架'
}
function getStatusTag(status) {
  if (status === 1) return 'tag-green'
  if (status === 2) return 'tag-red'
  return 'tag-gray'
}
module.exports = { resolveUrl: resolveUrl, formatPrice: formatPrice, getStatusText: getStatusText, getStatusTag: getStatusTag }
</wxs>

<view class="page-container">
  <view wx:if="{{!isAuthenticated}}" class="text-center py-xl">
    <text style="font-size: 80rpx;">📦</text>
    <view class="mt-md"><text class="text-secondary">请先登录</text></view>
    <button class="btn btn-primary mx-auto mt-md" style="width: 320rpx;" bindtap="goLogin">去登录</button>
  </view>

  <view wx:elif="{{!loading && products.length > 0}}">
    <view wx:for="{{products}}" wx:key="id" class="card flex" style="padding: 16rpx;">
      <image wx:if="{{item.images && item.images.length > 0}}" src="{{helper.resolveUrl(item.images[0])}}" mode="aspectFill" class="rounded-lg" style="width: 180rpx; height: 180rpx; flex-shrink: 0;"/>
      <view wx:else class="rounded-lg bg-bg flex items-center justify-center" style="width: 180rpx; height: 180rpx; flex-shrink: 0;">
        <text style="font-size: 48rpx;">📦</text>
      </view>
      <view class="flex-1 ml-md" style="min-width: 0;">
        <view class="flex items-center mb-xs">
          <text class="text-md font-semibold truncate flex-1">{{item.title}}</text>
          <view class="tag {{helper.getStatusTag(item.status)}} ml-xs" style="flex-shrink: 0;">{{helper.getStatusText(item.status)}}</view>
        </view>
        <text class="text-xl font-bold price-primary">¥{{helper.formatPrice(item.price)}}</text>
        <view class="flex items-center mt-sm text-xs text-tertiary">
          <text>库存 {{item.stockQuantity || 0}}</text>
          <text class="ml-md">浏览 {{item.viewCount || 0}}</text>
        </view>
        <view class="flex gap-xs mt-sm" style="flex-wrap: wrap;">
          <view wx:if="{{item.status === 1}}" class="tag tag-orange" style="font-size: 22rpx; padding: 8rpx 20rpx; line-height: 1.2;" data-action="off" data-id="{{item.id}}" catchtap="handleAction">下架</view>
          <view wx:if="{{item.status === 3}}" class="tag tag-green" style="font-size: 22rpx; padding: 8rpx 20rpx; line-height: 1.2;" data-action="list" data-id="{{item.id}}" catchtap="handleAction">上架</view>
          <view wx:if="{{item.status !== 2}}" class="tag tag-blue" style="font-size: 22rpx; padding: 8rpx 20rpx; line-height: 1.2;" data-action="edit" data-id="{{item.id}}" catchtap="handleAction">编辑</view>
          <view class="tag tag-red" style="font-size: 22rpx; padding: 8rpx 20rpx; line-height: 1.2;" data-action="delete" data-id="{{item.id}}" catchtap="handleAction">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="text-center py-xl">
    <text style="font-size: 80rpx;">📦</text>
    <view class="mt-sm"><text class="text-secondary">还没有发布商品</text></view>
    <button class="btn btn-primary mx-auto mt-md" style="width: 320rpx;" bindtap="goPublish">去发布</button>
  </view>

  <view wx:if="{{loading}}" class="text-center py-xl"><text class="text-secondary">加载中...</text></view>

  <!-- FAB 发布按钮（对齐 frontend-v2） -->
  <view wx:if="{{isAuthenticated}}" class="fixed flex items-center justify-center bg-primary rounded-full shadow-lg" style="bottom: 120rpx; right: 32rpx; width: 96rpx; height: 96rpx; z-index: 50;" bindtap="goPublish">
    <text style="font-size: 48rpx; color: #fff; line-height: 1;">+</text>
  </view>
</view>
